# Copy this file to .env and fill in the keys you plan to use.
# You do not need all three — only the ones your EMBEDDING_PROVIDER /
# LLM_MODEL selection in app/config.py actually calls.

# OpenRouter → optional embedding backend (EMBEDDING_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Groq → optional LLM backend for generation
GROQ_API_KEY=

# Gemini → default embedding backend (EMBEDDING_PROVIDER=gemini) and
# default LLM backend used by app/generation/llm.py
GEMINI_API_KEY=
